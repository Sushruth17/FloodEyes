# Which Gemini backend to use: "aistudio" (API key, local eval) or "vertex" (service account, Cloud Run)
GEMINI_BACKEND=aistudio
GEMINI_API_KEY=

# Vertex AI (used when GEMINI_BACKEND=vertex)
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=global

# Model IDs (never hard-code these elsewhere)
DEPTH_MODEL=gemini-3.8-flash
TRUST_MODEL=gemini-3.8-flash
CONTROL_ROOM_MODEL=gemini-3.1-pro-preview
FALLBACK_MODEL=gemini-3.8-flash
EMBEDDING_MODEL=gemini-embedding-2-preview

# Default city config (backend/cities/<id>.yaml)
DEFAULT_CITY=blr
